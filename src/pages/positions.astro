---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PagePhotos from '../components/PagePhotos.astro';
import Sources from '../components/Sources.astro';
import { positions, fundamentals } from '../data/positions';
import { S } from '../data/sources';
---
<Base title="Positions and roles" desc="The five basketball positions, what each does on offence and defence, and the modern role names.">
  <PageHead kicker="03 · Positions and roles" title="Five spots, many jobs." lede="The numbers 1 to 5 still describe who stands where. The role names under them describe what the player actually does." />
  <PagePhotos of="positions" />
  <section class="wrap">
    <div class="tog" role="group" aria-label="Show">
      <button type="button" data-v="text" aria-pressed="true">Overview</button>
      <button type="button" data-v="off" aria-pressed="false">Offence</button>
      <button type="button" data-v="def" aria-pressed="false">Defence</button>
    </div>
    <ul class="entries">
      {positions.map((p) => (
        <li class="entry reveal">
          <span class="mono badge">{p.n} · {p.short}</span>
          <h3>{p.name}</h3>
          <p data-v="text">{p.text}</p>
          <p data-v="off"><span class="mono badge">Offence</span> {p.off}</p>
          <p data-v="def"><span class="mono badge">Defence</span> {p.def}</p>
          <ul class="roles" aria-label="Modern role names">{p.roles.map((r) => <li>{r}</li>)}</ul>
          <Sources list={p.src} />
        </li>
      ))}
    </ul>
  </section>
  <section class="wrap">
    <h2 class="reveal">Eleven fundamentals</h2>
    <p class="lede reveal">Whatever the position or the age, these are the skills every player works on.</p>
    <ul class="chips">{fundamentals.map((f, i) => <li class="reveal" style={`--i:${i % 6}`}>{f}</li>)}</ul>
    <Sources list={[S.primer]} />
  </section>
</Base>
<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-v]')].filter((b) => b.tagName === 'BUTTON');
  const paras = [...document.querySelectorAll<HTMLElement>('p[data-v]')];
  const show = (v: string) => {
    tabs.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.v === v)));
    paras.forEach((p) => (p.hidden = p.dataset.v !== v));
  };
  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.v!)));
  show('text');
</script>
